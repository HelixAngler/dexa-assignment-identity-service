    "cookie-parser": "^1.4.7",
    "ioredis": "^6.0.0",
    "minio": "^8.0.7",
    "reflect-metadata": "^0.2",
    "rxjs": "^7.8"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@nestjs/testing": "^10",
    "@types/cookie-parser": "^1.4.10",
    "@types/jest": "^30",
    "@types/node": "^22",
    "@types/supertest": "^6",
    "eslint": "^9",
    "globals": "^15",
    "jest": "^30.5.2",
    "supertest": "^7",
    "ts-jest": "^29",
    "typescript": "^5.6",
    "typescript-eslint": "^8"
  },
  "overrides": {
    "multer": "2.3.0"
