{
  "name": "identity-service",
  "version": "0.1.0",
  "private": true,
  "description": "Auth, sessions, RBAC and employee CRUD microservice.",
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/src/auth/password-denylist && cp src/auth/password-denylist/breached-passwords.txt dist/src/auth/password-denylist/",
